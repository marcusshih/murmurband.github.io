---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/works.css';
import SiteHeader from '../components/SiteHeader.astro';
---
<SiteLayout>
<SiteHeader />

    <div class="bg">
        <picture>
            <source media="(min-width: 769px)" srcset="/works-bg.jpg">
            <source media="(min-width: 768px)" srcset="/star1.png">
            <img src="/star1.png"/>
        </picture>
    </div>

     <div class="title-2" >
            <img class="titleimg-2" src="/allmurmur.png"> 
        </div> 

    <div class="works-list">
        <div class="works-title">
            WORKS
        </div>   
        <div class="works">
            <a class="works-photo" href="/star.html">
                <img src="/star-work.png">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">The Star In The Universe<br>宇宙裡的星點</div></div>
                        <div class="works-date"><div class="text2">2024.12.06 RELEASED</div></div>
                        </div>    
            </a>
            <a class="works-photo" href="/missu.html">
                <img src="/missu.jpg">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">I Miss U<br>我好想你</div></div>
                        <div class="works-date"><div class="text2">2024.03.31 RELEASED</div></div>
                        </div>    
            </a>
            <a class="works-photo" href="/coexistence.html">
                <img src="/coexistence.png">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">Coexistence<br>共生</div></div>
                        <div class="works-date"><div class="text2">2023.11.27 RELEASED</div></div>
                        </div>    
            </a>
            <a class="works-photo" href="/tossandturn.html">
                <img src="/tossandturn.jpg">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">Toss And Turn<br>輾轉</div></div>
                        <div class="works-date"><div class="text2">2023.08.27 RELEASED</div></div>
                        </div>    
            </a>
            <a class="works-photo" href="/light.html">
                <img src="/light.jpg">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">To Rachel<br>給你的光</div></div>
                        <div class="works-date"><div class="text2">2023.07.19 RELEASED</div></div>
                        </div>    
            </a>

            <a class="works-photo" href="/far-away.html">
                <img src="/far-away.jpg">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">Far Away<br>遠走</div></div>
                        <div class="works-date"><div class="text2">2023.06.04 RELEASED</div></div>
                        </div>    
            </a>
            <a class="works-photo" href="/luna.html">
                <img src="/luna.png">
                        <div class="works-text">
                        <div class="works-name"><div class="text1">Luna</div></div>
                        <div class="works-date"><div class="text2">2023.03.21 RELEASED</div></div>
                        </div>    
            </a>

            <a class="works-photo" href="/letme.html" >
                <img src="/讓我.jpg" >
                        
                        <div class="works-text">
                        <div class="works-name"><div class="text1">Let Me Embrace You<br>讓我擁抱你所有的模樣</div></div>
                        <div class="works-date"><div class="text2">2022.10.28 RELEASED</div></div>
                        </div>  
                 
            </a>
        </div>  

       
</div>
    

<footer>this is footer</footer>
</SiteLayout>
