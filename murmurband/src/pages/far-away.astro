---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/lyrics.css';
import SiteHeader from '../components/SiteHeader.astro';
---
<SiteLayout>
<SiteHeader />
    
    <div class="bg">
        <picture>
            <source media="(min-width: 769px)" srcset="/works-bg.jpg">
            <source media="(min-width: 768px)" srcset="/star1.png">
            <img src="/star1.png"/>
        </picture>
    </div>

     <div class="title-2" >
            <img class="titleimg-2" src="/allmurmur.png"> 
        </div> 
    

    
    <div class = st> 
        <a class="st_title" href="https://youtu.be/-8ApBER-_JI?si=Qo5TGBMbJf5xFmKD">遠走</a>   
        <div class="st_composer">作詞・作曲：施柏年</div>   
        <div class="st_text">
            <br>嘿 還睡不著嗎
            <br>怎麼又開始迷惘的眼神裡隱藏多少渴望
            <br>嘿 那就別睡啊
            <br>打包行李去闖那些想受卻不敢受的傷
            <br>
            <br>這次不用再害怕
            <br>
            <br>那就遠走吧
            <br>世界再大也攔不住你的輕狂
            <br>讓誰淚如雨下的情話
            <br>沖散了你的去向
            <br>
            <br>那就啟程吧
            <br>多麼徬徨就看作是一個笑話
            <br>去到我去不了的地方
            <br>有我在等你回來
            <br>就走吧
            <br>
            <br>           
        </div>
        <div class="st_artist">
            編曲 Arranger｜盧瑞珍 Jane Lu／施柏年 Marcus Shih
            <br>主唱 Vocalist｜盧瑞珍 Jane Lu／施柏年 Marcus Shih
            <br>木吉他 Acoustic Guitarist｜施柏年 Marcus Shih
            <br>
            <br>
        </div>   
    </div>
    <div class="black"></div>
</SiteLayout>
